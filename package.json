{
  "name": "marxen",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "overrides": {
    "@xmldom/xmldom": "0.9.12",
    "katex": "0.18.2"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "architecture:check": "node scripts/architecture-check.mjs",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:e2e": "npm run test:e2e:product && npm run test:e2e:live",
    "test:bundling": "node --test scripts/*.test.mjs",
    "contracts:generate": "cargo run --manifest-path src-tauri/Cargo.toml --no-default-features --features dev-tools --bin export-contracts --",
    "contracts:check": "npm run contracts:generate -- --check",
    "ai-contracts:generate": "cargo run --manifest-path src-tauri/Cargo.toml --no-default-features --features dev-tools --bin export-ai-contracts --",
    "ai-contracts:check": "npm run ai-contracts:generate -- --check",
    "isolation-contracts:generate": "cargo run --manifest-path src-tauri/Cargo.toml --no-default-features --features dev-tools --bin export-isolation-contracts --",
    "isolation-contracts:check": "npm run isolation-contracts:generate -- --check",
    "bundle:neovim": "node scripts/bundle-neovim.mjs",
    "verify:neovim": "node scripts/verify-neovim.mjs",
    "tauri": "tauri",
    "desktop:dev": "tauri dev",
    "desktop:build": "npm run bundle:neovim && tauri build --config src-tauri/tauri.bundle.conf.json",
    "dev:live": "vite --config vite.live.config.ts --host 127.0.0.1",
    "test:e2e:product": "playwright test --project chromium",
    "test:e2e:live": "playwright test -c playwright.live.config.ts --project chromium"
  },
  "dependencies": {
    "@codemirror/lang-markdown": "6.5.0",
    "@codemirror/language": "6.12.4",
    "@codemirror/state": "6.5.2",
    "@codemirror/view": "6.38.8",
    "@lezer/highlight": "1.2.5",
    "@radix-ui/react-slot": "1.2.3",
    "@tauri-apps/api": "2.12.1",
    "@tauri-apps/plugin-dialog": "^2.8.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "leaflet": "^1.9.4",
    "lucide-react": "0.468.0",
    "mermaid": "^12.1.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "rehype-mathjax": "^7.1.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-github-blockquote-alert": "^2.1.0",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "shiki": "^4.5.0",
    "tailwind-merge": "3.3.1",
    "three": "^0.186.1",
    "topojson-client": "^3.1.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@tauri-apps/cli": "2.12.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.0",
    "@types/leaflet": "^1.9.22",
    "@types/node": "22.19.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "27.2.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.3.3",
    "vitest": "5.0.3"
  }
}
